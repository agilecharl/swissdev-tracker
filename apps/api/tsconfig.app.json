{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "../../", // Set rootDir to monorepo root to include libs
    "module": "nodenext",
    "types": ["node", "express"],
    "moduleResolution": "nodenext",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "../../libs/**/*.ts" // Include only libs from current monorepo
  ],
  "exclude": [
    "out-tsc",
    "dist",
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs",
    "../../libs/**/*.spec.ts",
    "../../libs/**/*.test.ts"
  ]
}
