// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["swissdev"]
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP

  @@schema("swissdev")
}

enum JobStatus {
  ACTIVE
  INACTIVE
  FILLED

  @@schema("swissdev")
}

model Company {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  description   String?
  industry      String
  size          String?
  location      String
  website       String?
  founded       Int?
  logo          String?
  benefits      String[]
  openPositions Int      @default(0)
  rating        Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  jobs Job[]

  @@map("companies")
  @@schema("swissdev")
}

model Job {
  id           Int       @id @default(autoincrement())
  title        String
  company      String
  companyId    Int?
  location     String
  type         JobType
  salary       String?
  description  String?
  requirements String[]
  postedDate   DateTime  @default(now())
  status       JobStatus @default(ACTIVE)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  Company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@map("jobs")
  @@schema("swissdev")
}