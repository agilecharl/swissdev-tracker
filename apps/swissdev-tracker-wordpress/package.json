{
  "name": "swissdev-tracker-wordpress",
  "version": "1.0.0",
  "description": "WordPress plugin with React frontend for development tracking",
  "main": "src/index.js",
  "scripts": {
    "build": "webpack --mode=production",
    "dev": "webpack --mode=development --watch",
    "build:admin": "webpack --config webpack.admin.js --mode=production",
    "dev:admin": "webpack --config webpack.admin.js --mode=development --watch",
    "build:frontend": "webpack --config webpack.frontend.js --mode=production",
    "dev:frontend": "webpack --config webpack.frontend.js --mode=development --watch"
  },
  "keywords": [
    "wordpress",
    "plugin",
    "react",
    "development",
    "tracking",
    "project-management"
  ],
  "author": "AgileCharl",
  "license": "MIT",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^7.2.0",
    "@mui/icons-material": "^7.2.0",
    "@mui/x-data-grid": "^7.24.0",
    "@mui/x-date-pickers": "^7.24.0",
    "axios": "^1.6.0",
    "date-fns": "^2.30.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.22.0",
    "@wordpress/scripts": "^27.0.0",
    "babel-loader": "^9.1.0",
    "css-loader": "^6.8.0",
    "html-webpack-plugin": "^5.5.0",
    "mini-css-extract-plugin": "^2.7.0",
    "sass": "^1.69.0",
    "sass-loader": "^13.3.0",
    "style-loader": "^3.3.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.0"
  },
  "peerDependencies": {
    "@wordpress/element": "*",
    "@wordpress/api-fetch": "*",
    "@wordpress/components": "*"
  }
}
